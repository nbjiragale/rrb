# Single owned Postgres with pgvector (Supabase / Neon free tier).
DATABASE_URL=postgresql://user:password@host:5432/rrb

# LLM router (v2+). DeepSeek exposes an Anthropic-compatible endpoint, so the
# Messages API shape works by swapping base URL + key + model names.
# LLM_BASE_URL=https://api.deepseek.com/anthropic
# LLM_API_KEY=
# LLM_MODEL_CHEAP=deepseek-chat
# LLM_MODEL_STRONG=deepseek-reasoner
