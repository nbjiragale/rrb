DATABASE_URL=postgres://user:pass@localhost:5432/rrb

# LLM router. LLM_API_FORMAT selects the wire format:
#   anthropic (default) — /v1/messages, x-api-key  (DeepSeek direct, Anthropic)
#   openai              — /v1/chat/completions, Bearer  (OpenRouter, OpenAI, …)

# --- Option 1: DeepSeek direct (Anthropic-compatible) ---
# LLM_BASE_URL=https://api.deepseek.com/anthropic
# LLM_API_KEY=sk-...
# LLM_MODEL_CHEAP=deepseek-chat
# LLM_MODEL_STRONG=deepseek-reasoner

# --- Option 2: OpenRouter (use your openrouter.ai key) ---
# LLM_API_FORMAT=openai
# LLM_BASE_URL=https://openrouter.ai/api
# LLM_API_KEY=sk-or-...
# LLM_MODEL_CHEAP=deepseek/deepseek-chat
# LLM_MODEL_STRONG=deepseek/deepseek-r1
#
# Optional: run the AI tutor on a different model from generation/bulk tasks —
# e.g. a Gemini Flash for nicer explanations while generation stays on DeepSeek.
# Pick the current slug from openrouter.ai/models.
# LLM_MODEL_TUTOR=google/gemini-2.5-flash
# To give the tutor live web search, use OpenRouter's online variant (extra cost;
# usually unnecessary for an exam tutor and not grounded like the CA pipeline):
# LLM_MODEL_TUTOR=google/gemini-2.5-flash:online

# Prompt caching (cost discipline §4/§8) is on by default. Set to 0 only if your
# provider rejects cache_control on the /anthropic wire format.
# LLM_PROMPT_CACHE=0
# Embeddings (OpenAI-compatible /v1/embeddings; 1024-d model, e.g. BGE-M3 / Voyage)
# EMBED_BASE_URL=https://api.voyageai.com
# EMBED_API_KEY=...
# EMBED_MODEL=bge-m3
# CRON_SECRET=...
# Firecrawl scraper for daily current affairs (https://firecrawl.dev)
# FIRECRAWL_API_KEY=fc-...
# Optional — only set for a self-hosted Firecrawl instance:
# FIRECRAWL_API_URL=https://api.firecrawl.dev
# Comma-separated source URL templates scraped nightly. Date tokens are expanded
# to the run's date: {day} (unpadded), {day2} (zero-padded), {month} (lowercase
# name e.g. "may"), {month2} (zero-padded number), {year}.
# Example for AffairsCloud (https://affairscloud.com/current-affairs-30-may-2026/):
# CA_SOURCE_URLS=https://affairscloud.com/current-affairs-{day}-{month}-{year}/
#
# CA sites publish a day's page late, so the scraper targets YESTERDAY by default
# (today's URL is usually an unpublished listing/fallback page with no news). If
# that day still isn't published, it walks back day by day to the most recent
# one that is. CA_MAX_LOOKBACK_DAYS caps how far (default 7, clamped 0..31); set
# 0 to disable walk-back and only try the target date.
# CA_MAX_LOOKBACK_DAYS=7
#
# Nightly auto-generation caps (Hard Rule §4 cost discipline). The cron turns
# fresh CA items into grounded cards and tops up practice questions for weak
# concepts. Defaults are conservative; set any to 0 to disable that step.
# CA_AUTOGEN_MAX_ITEMS=5        # CA items → cards per night
# CA_AUTOGEN_CARDS_PER_ITEM=3   # cards generated per CA item
# QGEN_MAX_CONCEPTS=3           # weak concepts topped up per night
# QGEN_PER_CONCEPT=3            # questions generated per concept
# QGEN_MIN_VERIFIED=5           # only replenish concepts below this many verified Qs
