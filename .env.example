DATABASE_URL=postgres://user:pass@localhost:5432/rrb

# LLM router. LLM_API_FORMAT selects the wire format:
#   anthropic (default) — /v1/messages, x-api-key  (DeepSeek direct, Anthropic)
#   openai              — /v1/chat/completions, Bearer  (OpenRouter, OpenAI, …)

# --- Option 1: DeepSeek direct (Anthropic-compatible) ---
# LLM_BASE_URL=https://api.deepseek.com/anthropic
# LLM_API_KEY=sk-...
# LLM_MODEL_CHEAP=deepseek-chat
# LLM_MODEL_STRONG=deepseek-reasoner

# --- Option 2: OpenRouter (use your openrouter.ai key) ---
# LLM_API_FORMAT=openai
# LLM_BASE_URL=https://openrouter.ai/api
# LLM_API_KEY=sk-or-...
# LLM_MODEL_CHEAP=deepseek/deepseek-chat
# LLM_MODEL_STRONG=deepseek/deepseek-r1
# Prompt caching (cost discipline §4/§8) is on by default. Set to 0 only if your
# provider rejects cache_control on the /anthropic wire format.
# LLM_PROMPT_CACHE=0
# Embeddings (OpenAI-compatible /v1/embeddings; 1024-d model, e.g. BGE-M3 / Voyage)
# EMBED_BASE_URL=https://api.voyageai.com
# EMBED_API_KEY=...
# EMBED_MODEL=bge-m3
# CRON_SECRET=...
# Firecrawl scraper for daily current affairs (https://firecrawl.dev)
# FIRECRAWL_API_KEY=fc-...
# Optional — only set for a self-hosted Firecrawl instance:
# FIRECRAWL_API_URL=https://api.firecrawl.dev
# Comma-separated source URL templates scraped nightly. Date tokens are expanded
# to the run's date: {day} (unpadded), {day2} (zero-padded), {month} (lowercase
# name e.g. "may"), {month2} (zero-padded number), {year}.
# Example for AffairsCloud (https://affairscloud.com/current-affairs-30-may-2026/):
# CA_SOURCE_URLS=https://affairscloud.com/current-affairs-{day}-{month}-{year}/
